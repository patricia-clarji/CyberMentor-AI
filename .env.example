# Local Windows development. npm run setup:local copies this file to .env
# only when .env does not already exist and replaces each generation marker.
CYBERMENTOR_LOCAL_HOST=127.0.0.1
CYBERMENTOR_WEB_PORT=5173
CYBERMENTOR_TRUSTED_API_PORT=8010
CYBERMENTOR_LEGACY_API_PORT=8787
CYBERMENTOR_ENVIRONMENT=development
CYBERMENTOR_EMAIL_BACKEND=console
CYBERMENTOR_DEV_SEED_ENABLED=false

# The local trusted API constructs an absolute durable SQLite URL automatically.
# Set CYBERMENTOR_DATABASE_URL explicitly only when intentionally testing PostgreSQL.

CYBERMENTOR_LLM_PROVIDER=
CYBERMENTOR_LLM_API_KEY=
CYBERMENTOR_LLM_BASE_URL=
CYBERMENTOR_LLM_MODEL=
CYBERMENTOR_LLM_TIMEOUT_SECONDS=12
CYBERMENTOR_LLM_TEMPERATURE=0.1
CYBERMENTOR_LLM_INPUT_COST_PER_MILLION=0
CYBERMENTOR_LLM_OUTPUT_COST_PER_MILLION=0
CYBERMENTOR_EMBEDDING_PROVIDER=test

# Generated now so a later Docker run does not inherit published example passwords.
POSTGRES_PASSWORD=__GENERATE_SECURE_LOCAL_VALUE__
MINIO_ROOT_USER=cybermentor
MINIO_ROOT_PASSWORD=__GENERATE_SECURE_LOCAL_VALUE__
