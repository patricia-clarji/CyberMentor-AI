        "submissionFields": {
          "indicator": { "accepted": ["permitrootlogin no", "passwordauthentication no"] },
          "classification": { "accepted": ["insecure ssh configuration", "ssh misconfiguration"] },
          "recommendation": { "keywords": ["root", "password", "0644", "test"], "minimumMatches": 3 },
          "report": { "keywords": ["sshd_config", "0644", "root", "verification"], "minimumMatches": 3, "minimumLength": 140 }
        }
      },
      "hints": [
        { "level": 1, "kind": "orientation", "text": "Inspect both file content and metadata." },
