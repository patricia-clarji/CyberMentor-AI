        { "id": "verify-config", "title": "Verify the simulated result", "required": true, "stage": 3 }
      ],
      "scenario": "A simulated SSH service allows root password login and its configuration is world writable. Harden the virtual configuration without touching the host.",
      "learnerInstructions": ["Inspect the file and metadata.", "Use the simulated chmod/chown commands.", "Submit the target settings and verification report."],
