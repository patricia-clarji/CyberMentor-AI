        ],
        "processes": [{ "pid": 910, "user": "www-data", "command": "nginx: worker process" }],
        "connections": [{ "protocol": "tcp", "local": "0.0.0.0:443", "remote": "0.0.0.0:*", "state": "LISTEN", "process": "nginx" }]
      },
      "validation": {
        "requiredCommands": ["grep"],
        "alternativeCommandPaths": [["cat"], ["tail"]],
        "submissionFields": {
          "indicator": { "accepted": ["198.51.100.77"] },
          "classification": { "accepted": ["web reconnaissance", "suspicious web reconnaissance"] },
          "recommendation": { "keywords": ["review", "waf", "block", "monitor"], "minimumMatches": 2 },
          "report": { "keywords": ["198.51.100.77", ".env", "404", "403"], "minimumMatches": 3, "minimumLength": 120 }
        }
      },
      "hints": [
        { "level": 1, "kind": "orientation", "text": "Identify which file records requests to the web service." },
        { "level": 2, "kind": "conceptual", "text": "Look for one source requesting sensitive or backup paths." },
        { "level": 3, "kind": "procedural", "text": "Filter the access log by a suspicious path or repeated address." },
        { "level": 4, "kind": "worked-example", "text": "A request for /.env is a reconnaissance lead; correlate it with other paths and response codes." },
        { "level": 5, "kind": "guided-mode", "text": "Read /var/log/nginx/access.log and report the source requesting /.env, a backup file, and /admin." }
      ],
      "reflectionQuestions": ["What do the response codes imply about exposure?", "What evidence would distinguish scanning from exploitation?"],
      "completionCriteria": { "minimumRequiredObjectives": 3, "minimumOverallBand": "developing", "reportRequired": true },
      "generatedEvidence": { "artifactType": "analysis-summary", "title": "Web reconnaissance analysis" },
      "portfolioEligibility": true,
      "expertSolution": ["Inspect the Nginx access log.", "Group suspicious paths by source.", "Report 198.51.100.77 and the response codes.", "Avoid claiming successful access.", "Recommend monitoring and WAF review."]
    },
