  "labs": [
    {
      "id": "soc-lab-linux-auth-triage",
      "version": "1.0.0",
      "title": "Triage repeated SSH authentication failures",
      "labType": "guided",
      "category": "Linux and authentication",
      "difficulty": "foundation",
      "estimatedMinutes": 35,
      "prerequisites": ["linux-navigation", "linux-logs"],
      "linkedSkills": ["linux-navigation", "linux-logs", "authentication-events", "alert-triage"],
      "objectives": [
        { "id": "locate-log", "title": "Locate the authentication log", "required": true, "stage": 1 },
        { "id": "identify-source", "title": "Identify the repeated source address", "required": true, "stage": 2 },
        { "id": "bound-conclusion", "title": "State a bounded triage conclusion", "required": true, "stage": 3 },
        { "id": "bonus-process-check", "title": "Check for a correlated process", "required": false, "bonus": true, "stage": 2 }
      ],
      "scenario": "A fictional Linux jump host generated an SSH alert. Determine what happened, preserve the relevant evidence, and recommend the next defensive action.",
      "learnerInstructions": [
        "Use only the simulated terminal and supplied files.",
        "Begin by locating relevant logs; do not assume the alert proves compromise.",
        "Submit the source address, conclusion, recommendation, and reflection."
      ],
      "availableTools": ["pwd", "ls", "cd", "cat", "grep", "find", "ps", "netstat", "ss", "journalctl", "tail", "head"],
      "virtualEnvironment": {
        "cwd": "/home/analyst",
        "files": [
          { "path": "/home/analyst/README.txt", "content": "Authorized synthetic investigation. Authentication records are under /var/log.", "mode": "0644", "owner": "analyst", "group": "soc" },
          { "path": "/var/log/auth.log", "content": "Jul 30 09:14:01 jump01 sshd[2114]: Failed password for invalid user admin from 203.0.113.42 port 51120 ssh2\nJul 30 09:14:04 jump01 sshd[2118]: Failed password for invalid user admin from 203.0.113.42 port 51124 ssh2\nJul 30 09:14:09 jump01 sshd[2121]: Failed password for salma from 203.0.113.42 port 51131 ssh2\nJul 30 09:17:33 jump01 sshd[2160]: Accepted publickey for backup from 192.0.2.18 port 49221 ssh2", "mode": "0640", "owner": "root", "group": "adm" },
          { "path": "/var/log/syslog", "content": "Jul 30 09:14:00 jump01 systemd[1]: Started Daily apt download activities.\nJul 30 09:16:00 jump01 cron[2140]: session opened for user root", "mode": "0640", "owner": "root", "group": "adm" }
        ],
        "processes": [
          { "pid": 1, "user": "root", "command": "/sbin/init" },
          { "pid": 820, "user": "root", "command": "/usr/sbin/sshd -D" },
          { "pid": 2240, "user": "analyst", "command": "bash" }
        ],
        "connections": [
          { "protocol": "tcp", "local": "0.0.0.0:22", "remote": "0.0.0.0:*", "state": "LISTEN", "process": "sshd" }
        ]
      },
      "checkpoints": [
        { "afterCommand": "pwd", "feedback": "You established the starting location before navigating." },
        { "afterCommand": "grep", "feedback": "Filtering the authentication log reduces unrelated records." }
      ],
      "validation": {
        "requiredCommands": ["pwd", "grep"],
        "alternativeCommandPaths": [["cat"], ["tail"], ["journalctl"]],
        "submissionFields": {
          "indicator": { "accepted": ["203.0.113.42"] },
          "classification": { "accepted": ["suspicious authentication", "ssh password spraying", "password spraying"] },
          "recommendation": { "keywords": ["correlate", "identity", "block", "monitor"], "minimumMatches": 2 },
          "report": { "keywords": ["203.0.113.42", "failed", "uncertainty", "next"], "minimumMatches": 3, "minimumLength": 120 }
        }
      },
      "hints": [
        { "level": 1, "kind": "orientation", "text": "Start by identifying your current directory and the available top-level evidence locations." },
        { "level": 2, "kind": "conceptual", "text": "Authentication failures are commonly recorded in an authentication log or service journal." },
        { "level": 3, "kind": "procedural", "text": "Use grep with a relevant term against a file under /var/log." },
        { "level": 4, "kind": "worked-example", "text": "Example pattern: grep 'Failed password' /path/to/log. Adapt the path to this scenario." },
        { "level": 5, "kind": "guided-mode", "text": "Run grep 'Failed password' /var/log/auth.log, count the repeated source, then state what the evidence does and does not prove." }
      ],
      "reflectionQuestions": ["What additional identity or firewall evidence would change your confidence?", "Why is a failed-login burst not proof of host compromise?"],
      "completionCriteria": { "minimumRequiredObjectives": 3, "minimumOverallBand": "developing", "reportRequired": true },
      "generatedEvidence": { "artifactType": "incident-report", "title": "SSH authentication triage report" },
      "portfolioEligibility": true,
      "expertSolution": ["Establish location and scope.", "Filter auth.log for failed SSH attempts.", "Identify 203.0.113.42 as the repeated source.", "Separate password-spraying evidence from compromise claims.", "Recommend identity/firewall correlation and monitored blocking."]
    },
    {
      "id": "soc-lab-web-log-independent",
      "version": "1.0.0",
      "title": "Investigate anomalous web access independently",
      "labType": "independent",
      "category": "Web logs",
      "difficulty": "intermediate",
      "estimatedMinutes": 40,
