          "recommendation": { "keywords": ["parent", "outlook", "command", "powershell"], "minimumMatches": 3 },
          "report": { "keywords": ["selection", "condition", "false positive", "outlook"], "minimumMatches": 3, "minimumLength": 160 }
        }
      },
      "hints": [
        { "level": 1, "kind": "orientation", "text": "Inspect the available process-event dataset." },
