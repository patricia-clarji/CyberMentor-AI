        ],
        "processes": [{ "pid": 820, "user": "root", "command": "/usr/sbin/sshd -D" }],
        "connections": [{ "protocol": "tcp", "local": "0.0.0.0:22", "remote": "0.0.0.0:*", "state": "LISTEN", "process": "sshd" }]
      },
      "validation": {
        "requiredCommands": ["cat", "chmod", "chown"],
        "alternativeCommandPaths": [["ls"]],
