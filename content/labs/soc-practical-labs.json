        { "id": "document-web", "title": "Document a defensible finding", "required": true, "stage": 3 }
      ],
      "scenario": "An Nginx service produced an alert for unusual access. Decide how to investigate using only the synthetic records.",
      "learnerInstructions": ["Investigate independently.", "No prescriptive command sequence is provided.", "Submit the strongest indicator and a reproducible report."],
      "availableTools": ["pwd", "ls", "cd", "cat", "grep", "find", "tail", "head"],
      "virtualEnvironment": {
