          { "path": "/evidence/endpoint/events.log", "content": "10:03:04Z host=FIN-14 parent=OUTLOOK.EXE process=powershell.exe command=\"powershell -enc ...\"\n10:03:19Z host=FIN-14 dns=login-check.example answer=203.0.113.80", "mode": "0440", "owner": "analyst", "group": "soc" },
          { "path": "/evidence/identity/signins.log", "content": "10:14:02Z user=salma result=success source=203.0.113.80 device=unmanaged", "mode": "0440", "owner": "analyst", "group": "soc" }
