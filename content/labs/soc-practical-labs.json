    {
      "id": "soc-lab-sshd-hardening",
      "version": "1.0.0",
      "title": "Harden a simulated SSH service",
      "labType": "secure-configuration",
      "category": "Linux hardening",
      "difficulty": "foundation",
      "estimatedMinutes": 35,
      "prerequisites": ["linux-permissions", "linux-navigation"],
      "linkedSkills": ["linux-permissions", "linux-navigation", "evidence-preservation"],
      "objectives": [
        { "id": "inspect-config", "title": "Inspect SSH configuration and permissions", "required": true, "stage": 1 },
