{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cybermentor.local/schema/publication.json",
  "title": "CyberMentor immutable content publication",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "title",
    "contentVersion",
    "contentHash",
    "artifactType",
    "riskClassification",
    "verificationStatus",
    "publicationStatus",
    "publishedAt",
    "lastReviewedAt",
    "nextReviewAt",
    "metadata",
    "artifact",
    "claims",
    "references",
    "provenance"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "contentVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+([+-][a-zA-Z0-9.-]+)?$"
    },
    "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactType": {
      "enum": [
        "course",
        "module",
        "lesson",
        "question",
        "lab",
        "scenario",
        "project",
        "rubric",
        "glossary-entry",
        "certification-mapping",
        "completion-rule",
        "explanation-variant",
        "practice-activity"
      ]
    },
    "riskClassification": { "enum": ["defensive", "dual-use"] },
    "approvalBasis": {
      "enum": ["v1-release-baseline", "standard-review-workflow"]
    },
    "releaseApproval": {
      "type": "object",
      "properties": {
        "authority": { "const": "product-owner" },
        "decision": { "const": "approved" },
        "scope": { "const": "initial-v1-academy" },
        "recordedAt": { "type": "string", "format": "date-time" },
        "includesSafetyReview": { "type": "boolean" }
      }
    },
    "verificationStatus": { "const": "verified" },
    "publicationStatus": { "const": "published" },
    "publishedAt": { "type": "string", "format": "date-time" },
    "lastReviewedAt": { "type": "string", "format": "date-time" },
    "nextReviewAt": { "type": "string", "format": "date-time" },
    "artifact": { "type": "object" },
    "references": { "type": "array", "minItems": 1 },
    "provenance": {
      "type": "object",
      "required": ["author", "publisher", "reviews"],
      "properties": {
        "author": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string", "minLength": 1 },
        "reviews": {
          "type": "array",
          "items": { "type": "object" }
        }
      }
    }
  }
}
