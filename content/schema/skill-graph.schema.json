{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cybermentor.local/schema/skill-graph.json",
  "title": "CyberMentor skill graph",
  "type": "object",
  "required": ["schemaVersion", "version", "status", "skills"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": { "enum": ["draft-taxonomy", "reviewed"] },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "domain",
          "description",
          "difficulty",
          "parentSkillId",
          "prerequisites"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 2 },
          "domain": { "type": "string", "minLength": 2 },
          "description": { "type": "string", "minLength": 20 },
          "difficulty": {
            "enum": [
              "foundation",
              "guided",
              "standard",
              "advanced",
              "expert-challenge"
            ]
          },
          "parentSkillId": { "type": ["string", "null"] },
          "prerequisites": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
