{
  "name": "cybermentor-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/seed-v1-academy.mjs",
    "setup:local": "node scripts/local-dev.mjs setup",
    "predev": "node scripts/local-dev.mjs prepare",
    "dev": "node scripts/local-dev.mjs start",
    "prepare:trusted": "node scripts/local-dev.mjs prepare",
    "dev:trusted": "node scripts/run-trusted-backend.mjs",
    "dev:api": "node --env-file-if-exists=.env server/server.mjs --api-only",
    "dev:web": "vite",
    "start": "node --env-file-if-exists=.env server/server.mjs",
    "build": "tsc -b && vite build",
    "preview": "npm run build && npm start",
    "test": "node scripts/test-all.mjs",
    "test:watch": "vitest",
    "lint": "eslint src server scripts vite.config.ts",
    "typecheck": "tsc -b",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "seed:v1": "node scripts/seed-v1-academy.mjs",
    "db:migrate": "node scripts/backend-command.mjs migrate",
    "db:status": "node scripts/backend-command.mjs migration-status",
    "db:verify": "node scripts/backend-command.mjs verify",
    "db:seed": "node scripts/backend-command.mjs seed",
    "db:seed-dev": "node scripts/backend-command.mjs seed-dev",
    "create-local-admin": "node scripts/backend-command.mjs seed-dev-local",
    "db:rollback": "node scripts/backend-command.mjs rollback",
    "test:backend": "node scripts/backend-command.mjs test",
    "lint:backend": "node scripts/backend-command.mjs lint",
    "typecheck:backend": "node scripts/backend-command.mjs typecheck",
    "format:backend": "node scripts/backend-command.mjs format",
    "verify:live": "node scripts/verify-live.mjs",
    "content:refresh": "node scripts/content-pipeline.mjs refresh",
    "content:validate": "node scripts/content-pipeline.mjs validate",
    "content:status": "node scripts/content-pipeline.mjs status",
    "content:review": "node scripts/content-pipeline.mjs review",
    "content:publish": "node scripts/content-pipeline.mjs publish",
    "content:import": "node scripts/content-pipeline.mjs import",
    "content:sync": "node scripts/content-pipeline.mjs sync",
    "content:rollback": "node scripts/content-pipeline.mjs rollback",
    "content:check-references": "node scripts/content-pipeline.mjs refresh",
    "validate-content": "vitest run src/data/content.test.ts scripts/content-pipeline.test.mjs && node scripts/content-pipeline.mjs validate",
    "evaluate-ai": "vitest run src/lib/sentinel.test.ts src/lib/sentinel.eval.test.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.85.5",
    "lucide-react": "1.25.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "wouter": "^3.7.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "concurrently": "^10.0.4",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
